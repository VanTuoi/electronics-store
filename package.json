        "bootstrap": "^5.0.1",
        "bootstrap-icons": "^1.11.3",
        "font-awesome": "^4.7.0",
        "husky": "^9.1.6",
        "jotai": "^2.12.2",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-hook-form": "^7.54.2",
        "react-hot-toast": "^2.5.2",
        "react-router-dom": "^7.1.5",
        "react-turnstile": "^1.1.4",
        "slide": "^1.1.6",
        "swiper": "^11.2.4",
        "yet-another-react-lightbox": "^3.21.8",
        "zod": "^3.24.2"
