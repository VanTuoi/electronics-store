        "jsdom": "^26.0.0",
        "lint-staged": "^15.2.10",
        "prettier": "^3.5.1",
        "sass": "^1.86.0",
        "typescript": "~5.7.2",
        "typescript-eslint": "^8.22.0",
        "vite": "^6.1.0",
        "vitest": "^3.0.6"
